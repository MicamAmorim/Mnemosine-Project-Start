{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build-static.mjs",
  "outputDirectory": "public",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/03_Gerador/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, max-age=0"}
      ]
    }
  ]
}
